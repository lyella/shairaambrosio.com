{
  "name": "shairaambrosio.com",
  "description": "My personal website",
  "author": "Shaira Ambrosio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "bash ./build.sh redirect feed sitemap next",
    "start": "next start",
    "tsc": "node scripts/patch-mdx-types.mjs --quiet && tsc --noEmit",
    "ts-node-esm": "node --loader ts-node/esm --experimental-specifier-resolution=node",
    "algolia": "yarn ts-node-esm generateAlgoliaItems.ts",
    "feed": "yarn ts-node-esm generateFeed.ts",
    "sitemap": "yarn ts-node-esm generateSitemap.ts",
    "new-post-redirect": "yarn ts-node-esm generateNewPostRedirect.ts",
    "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,css,scss,md,mdx}\"",
    "format:check": "prettier --check \"./**/*.{js,jsx,ts,tsx,css,scss,md,mdx}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit:gate": "bash ./scripts/audit-gate.sh",
    "postinstall": "node scripts/patch-mdx-types.mjs",
    "prepare": "husky",
    "test": "vitest run",
    "sitemap:submit": "node scripts/submit-sitemap.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyella/shairaambrosio.com"
  },
  "bugs": {
    "url": "https://github.com/lyella/shairaambrosio.com/issues"
  },
  "homepage": "https://shairaambrosio.com",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix"
    ],
    "*.{json,css,scss,md,mdx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@sendgrid/mail": "^8.1.4",
    "@tanstack/react-query": "^5.62.0",
    "@vercel/analytics": "^1.4.0",
    "algoliasearch": "^4.24.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "eslint-plugin-import": "^2.31.0",
    "feed": "^4.2.2",
    "framer-motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "invariant": "^2.2.4",
    "next": "^16.4.1",
    "next-mdx-remote": "^6.0.0",
    "next-pwa": "^5.6.0",
    "plaiceholder": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dom-confetti": "^0.2.0",
    "react-github-btn": "^1.4.0",
    "react-hook-form": "^7.53.2",
    "react-instantsearch": "^7.13.0",
    "react-lottie": "^1.2.7",
    "react-paginate": "^8.3.0",
    "reading-time": "^1.5.0",
    "sharp": "^0.35.0",
    "slugify": "^1.6.6",
    "vercel": "^39.0.2",
    "webpack": "^5.97.1",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query-devtools": "^5.62.0",
    "@types/gtag.js": "^0.0.20",
    "@types/invariant": "^2.2.37",
    "@types/node": "22.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-lottie": "^1.2.10",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^9.7",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "next-seo": "^6.6.0",
    "prettier": "^3.3.3",
    "rehype-prism-plus": "^2.0.2",
    "rehype-stringify": "10",
    "remark-rehype": "11",
    "sass": "^1.81.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "unified": "11.0",
    "unist-util-visit": "5.0.0",
    "vite-tsconfig-paths": "^5",
    "vitest": "^3.2.6"
  },
  "resolutions": {
    "path-to-regexp": ">=6.3.0",
    "browserslist": ">=4.28.7",
    "brace-expansion": ">=2.0.2",
    "source-map-js": ">=1.2.2",
    "serialize-javascript": ">=7.0.3",
    "undici": ">=6.24.0 <7",
    "axios": ">=1.20.0",
    "follow-redirects": ">=1.16.1",
    "fast-uri": ">=3.1.4",
    "svgo": ">=3.3.4",
    "@fastify/busboy": ">=3.2.1",
    "zod": ">=4.6.6",
    "sharp": ">=0.35.0",
    "tar": ">=7.5.19",
    "eslint-plugin-react": "^7.37.5",
    "@eslint/config-array": "^0.23.6",
    "@eslint/object-schema": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
