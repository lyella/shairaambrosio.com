# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# NOTE: this used to be a bare `.env*`, which also excluded .env-sample — the
# documented template every contributor is told to copy from was never committed.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env-sample

# vercel
.vercel

# typescript
*.tsbuildinfo

# generated at build time by next-pwa — never commit the service worker bundle
/public/sw.js
/public/workbox-*.js
/public/fallback-*.js

# NOTE: public/feed.xml, feed.json, sitemap.xml and robots.txt are generated by
# build.sh but stay committed, so a deploy whose generator step fails still
# publishes working discovery files instead of 404s.

# local-only dev notes, not for github
/notes/
